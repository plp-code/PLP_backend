# Copy this file to `.env` and fill in the REQUIRED values.
#   cp .env.example .env
# Everything else has a sensible default and can be left out.

# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Async MySQL connection. Format: mysql+aiomysql://USER:PASSWORD@HOST:PORT/DBNAME
# Do NOT put ?ssl=require in the URL — TLS is controlled by DB_SSL_REQUIRED below.
DATABASE_URL=mysql+aiomysql://user:password@host:25060/defaultdb

# Set true for managed MySQL (DigitalOcean/RDS/etc.) that requires TLS.
# Leave false for a plain local MySQL.
DB_SSL_REQUIRED=true

# JWT signing key — MUST be at least 32 characters. Generate a strong one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars

# Stripe (use your test-mode keys for local dev)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── OPTIONAL (defaults shown) ───────────────────────────────────────────────

# API
# API_V1_STR=/api/v1
# ENVIRONMENT=development
# FRONTEND_URL=http://localhost:3000

# Database pool tuning
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE_SECONDS=1800

# Redis (must be running — the app pings it on startup)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_TIMEOUT=5

# Rate limiting
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS_PER_MINUTE=120

# JWT
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7
